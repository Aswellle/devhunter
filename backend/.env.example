# DevHunter 环境变量配置示例
# 复制此文件为 .env 并修改对应值

# ── 应用配置 ────────────────────────────────────
APP_ENV=development           # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false                # 生产环境务必为 false，避免暴露堆栈跟踪

# ── 数据库 ────────────────────────────────────────
# SQLite 数据库文件路径（相对于 backend/ 目录）
DB_PATH=data/devhunter.db

# ── 认证 ──────────────────────────────────────────
# 单用户密码（MVP：直接在此配置。S10：这里必须是占位符，不要填真实可用密码，
# 否则任何人复制此文件即可用已知密码登录；生产环境启动时会拒绝使用该占位符）
AUTH_PASSWORD=<请修改为强密码>
# JWT Secret（任意随机字符串，生产环境请用 openssl rand -hex 32 生成）
SECRET_KEY=<请用 openssl rand -hex 32 生成>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080     # 7 天

# ── 抓取配置 ──────────────────────────────────────
CRAWLER_TIMEOUT=15           # HTTP 请求超时秒数
CRAWLER_MAX_RESPONSE_MB=5    # 响应体最大 MB
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# ── 调度器 ────────────────────────────────────────
SCHEDULER_MAX_WORKERS=3
SCHEDULER_MISFIRE_GRACE_TIME=300

# ── 日志 ──────────────────────────────────────────
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json              # json | text

# ── CORS ─────────────────────────────────────────
# 前端开发服务器地址，多个地址逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5200
