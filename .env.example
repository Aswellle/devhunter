# DevHunter Docker Compose 环境变量
# 复制为 .env 并修改后运行 docker compose up -d

# 访问密码（必须修改 —— S10: 此处必须是占位符而非真实可用密码，
# 否则 `cp .env.example .env && docker compose up` 就会以公开已知
# 密码部署，生产环境启动时 validate_production_secrets() 会拒绝
# 使用此占位符值启动）
AUTH_PASSWORD=<请修改为强密码>

# JWT 密钥（生产环境请用 openssl rand -hex 32 生成）
SECRET_KEY=<请用 openssl rand -hex 32 生成>
